# PostgreSQL connection. Use a Neon pooled or direct connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Generate with: openssl rand -base64 48
APP_SESSION_SECRET="replace-with-at-least-32-random-characters"

# Set only in production deployment.
NODE_ENV="development"

# POULTRY CENTRE AI (server-side only). Start with Groq; OpenAI can be selected later.
AI_PROVIDER="groq"
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
# Optional future provider: set AI_PROVIDER="openai" and configure OPENAI_API_KEY.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
